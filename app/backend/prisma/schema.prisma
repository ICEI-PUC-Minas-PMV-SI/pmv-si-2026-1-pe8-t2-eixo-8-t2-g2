generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  // url      = "file:./dev.db"
}

// datasource db {
//   provider = "postgresql"
// }

enum UserRole {
  admin
  customer
}

model Address {
  id String @id @default(uuid())

  street       String
  city         String
  state        String
  neighborhood String
  postalCode   String
  country      String
  number       String
  complement   String?

  isPrimary Boolean @default(false)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id String @id @default(uuid())

  name  String
  phone String?
  email String? @unique

  notes String?

  userId    String?   @unique
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  addresses Address[]

  schedulers Scheduler[]

  createdAt DateTime @default(now())

  @@index([phone])
  @@index([email])
}

model User {
  id               String         @id @default(uuid())
  name             String
  email            String         @unique
  phone            String?        @unique
  googleId         String?        @unique
  role             UserRole       @default(customer)
  password         String?
  otpSecret        String?
  twoFactorSecret  String?
  enabledTwoFactor Boolean        @default(false)
  customer         Customer?
  createdAt        DateTime       @default(now())
  recoveryCodes    RecoveryCode[]
}

model Category {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?
  isActive    Boolean @default(true)
  orderIndex  Int     @default(0)

  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")

  products ProductCategory[]

  createdAt DateTime @default(now())

  @@index([parentId])
  @@index([isActive])
}

model ProductCategory {
  id String @id @default(uuid())

  productId String
  product   Product @relation(fields: [productId], references: [id])

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())

  @@unique([productId, categoryId])
  @@index([categoryId])
  @@index([productId])
}

model Characteristic {
  id   String @id @default(uuid())
  name String @unique

  products ProductCharacteristic[]
}

model ProductCharacteristic {
  productId        String
  characteristicId String

  product        Product        @relation(fields: [productId], references: [id])
  characteristic Characteristic @relation(fields: [characteristicId], references: [id])

  @@id([productId, characteristicId])
}

model Product {
  id                     String  @id @default(uuid())
  name                   String
  slug                   String  @unique
  description            String?
  price                  Float   @default(0)
  estimatedMinPrice      Float   @default(0)
  estimatedMaxPrice      Float   @default(0)
  bookingLeadTimeMinutes Int     @default(0)
  bookingLeadDays        Int     @default(0)
  isActive               Boolean @default(true)

  categories      ProductCategory[]
  schedulerItems  SchedulerItem[]
  characteristics ProductCharacteristic[]

  createdAt DateTime @default(now())

  @@index([isActive])
}

model SchedulerItem {
  id String @id @default(uuid())

  schedulerId String
  scheduler   Scheduler @relation("SchedulerItems", fields: [schedulerId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity Int @default(1)

  priceAtBooking  Float?
  durationMinutes Int?
  customization   String?

  orderIndex Int

  createdAt DateTime @default(now())
}

enum SchedulerStatus {
  pending
  confirmed
  in_progress
  completed
  cancelled
}

enum IntegrationType {
  gmail
  calendar
  all
}

enum PaymentMethod {
  credit_card
  debit_card
  pix
  bank_transfer
  cash
}

enum DeliveryType {
  pickup
  delivery
}

model Scheduler {
  id                 String          @id @default(uuid())
  customerId         String
  customer           Customer        @relation(fields: [customerId], references: [id])
  scheduledAt        DateTime
  scheduledTo        DateTime?
  estimatedStartAt   DateTime?
  estimatedEndAt     DateTime?
  items              SchedulerItem[] @relation("SchedulerItems")
  status             SchedulerStatus @default(pending)
  paymentMethod      PaymentMethod
  deliveryType       DeliveryType
  cancellationReason String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @default(now()) @updatedAt

  googleEventId String?
}

model GoogleCredentials {
  id                    String          @id @default(uuid())
  encryptedRefreshToken String
  encryptedAccessToken  String
  tokenType             String
  tokenId               String
  integration           IntegrationType
}

model GoogleIntegration {
  id String @id @default(uuid())

  googleEmail String?

  clientId              String
  encryptedClientSecret String
  encryptedRefreshToken String?

  tokenType String?

  scopes String

  mailFrom       String?
  mailSenderName String?

  useForCalendar Boolean @default(false)
  useForEmail    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RecoveryCode {
  id       String    @id @default(cuid())
  codeHash String    @unique
  used     Boolean   @default(false)
  usedAt   DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
}

model AppSettings {
  id String @id @default("default")

  siteName String?

  logoUrl String?

  whatsapp     String?
  contactEmail String?
  serviceHours String?
  address      String?

  instagram String?

  primaryColor   String?
  secondaryColor String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AboutInfo {
  id            String      @id @default(cuid())
  title         String
  subtitle      String
  main          String
  complementary String
  items         AboutItem[] @relation("AboutItem")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @default(now()) @updatedAt
}

model AboutItem {
  id String @id @default(uuid())

  text       String
  orderIndex Int       @default(0)
  aboutId    String
  aboutInfo  AboutInfo @relation("AboutItem", fields: [aboutId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
}
