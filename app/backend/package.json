{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && tsc-alias",
    "format": "prettier --write \"src/**/*.{ts,js,json,md,css,scss,html}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json,md,css,scss,html}\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:apply": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:format": "prisma format",
    "db:validate": "prisma validate",
    "db:seed": "npm run build && node prisma/seed.js",
    "barrels:gen": "node ./scripts/generate-barrels.js src",
    "fix-imports": "node ./scripts/transform-imports.js transform",
    "fix-imports:revert": "node ./scripts/transform-imports.js revert"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "@prisma/generator-helper": "^7.4.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.3.0",
    "@types/nodemailer": "^7.0.11",
    "prettier": "^3.8.0",
    "prisma": "^7.5.0",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.4.1",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "axios": "^1.16.1",
    "base32-encode": "^2.0.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "google-auth-library": "^10.6.2",
    "googleapis": "^171.4.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^8.0.1",
    "otpauth": "^9.5.0",
    "winston": "^3.19.0",
    "zod": "^4.3.6"
  }
